# ---- TaskBounty desktop app configuration ----
# Copy to `.env`. Leave DATA_MODE=mock to run offline with demo data.

# 'mock' (offline demo data) or 'supabase' (real cloud data)
VITE_DATA_MODE=mock

# Only needed when VITE_DATA_MODE=supabase — from your Supabase project settings:
#   Project Settings -> API -> Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

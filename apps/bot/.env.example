# ---- TaskBounty bot configuration ----
# Copy this file to `.env` and fill in the values.

# Telegram bot token from @BotFather: https://t.me/BotFather  ->  /newbot
BOT_TOKEN=123456789:AA...replace-me...

# The two participants, by @username (preferred) or numeric Telegram ID.
#   Approver = User 2 (verifies submissions & pays out)
#   Doer     = User 1 (does the tasks & earns the balance)
# Tip: send /whoami to the bot to discover your username and numeric ID.
APPROVER_TELEGRAM=@alice
DOER_TELEGRAM=@bob

# Currency symbol for display. In V1 money is just a number — no real payments.
CURRENCY=$

# IANA timezone used for schedules & reminders.
# Examples: UTC, America/New_York, Asia/Kolkata, Europe/London
TZ=UTC

# How many hours after assignment a task is "due" (drives overdue reminders).
DEFAULT_DUE_HOURS=12

# Folder for the SQLite database and downloaded proof photos (SQLite mode).
DATA_DIR=./data

# ---- Supabase (optional — shared cloud DB with the desktop app) ----
# Set BOTH to run on Supabase instead of local SQLite. Then the bot and the
# desktop app share one datastore, proof photos go to the 'proofs' bucket, and
# the bot delivers the app's login codes over Telegram.
# From your Supabase project -> Settings -> API:
#   SUPABASE_URL         = Project URL, e.g. https://xxxx.supabase.co
#   SUPABASE_SERVICE_KEY = the SECRET / service_role key (server-side only —
#                          never ship this in the desktop app or commit it)
# Run supabase/migrations + seed.sql first so the tables exist.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- TaskBounty bot configuration ----
# Copy this file to `.env` and fill in the values.

# Telegram bot token from @BotFather: https://t.me/BotFather  ->  /newbot
BOT_TOKEN=123456789:AA...replace-me...

# The two participants, by @username (preferred) or numeric Telegram ID.
#   Approver = User 2 (verifies submissions & pays out)
#   Doer     = User 1 (does the tasks & earns the balance)
# Tip: send /whoami to the bot to discover your username and numeric ID.
APPROVER_TELEGRAM=@alice
DOER_TELEGRAM=@bob

# Currency symbol for display. In V1 money is just a number — no real payments.
CURRENCY=$

# IANA timezone used for schedules & reminders.
# Examples: UTC, America/New_York, Asia/Kolkata, Europe/London
TZ=UTC

# How many hours after assignment a task is "due" (drives overdue reminders).
DEFAULT_DUE_HOURS=12

# Folder for the SQLite database and downloaded proof photos.
DATA_DIR=./data
